import cv2
import matplotlib.pyplot as plt

def save_high_quality_mask(image_path, output_path='high_quality_mask.png'):
    # 读取并预处理图像
    img = cv2.imread(image_path)
    if img is None:
        raise FileNotFoundError("图像读取失败，请检查路径")
    
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (5,5), 0)
    
    # 阈值处理
    _, white_mask = cv2.threshold(blurred, 0, 255, 
                                cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
    
    # 创建纯画布保存结果
    fig = plt.figure(figsize=(8,8), dpi=300)
    plt.imshow(white_mask, cmap='gray', vmin=0, vmax=255)  # 显式设置数值范围
    plt.axis('off')
    
    # 根据文件格式调整保存参数
    if output_path.lower().endswith(('.png', '.tiff', '.tif')):
        # 支持元数据的格式
        plt.savefig(output_path, 
                   bbox_inches='tight', 
                   pad_inches=0,
                   dpi=600,
                   metadata={'Software': 'Scientific Imaging'},
                   facecolor='none')
    elif output_path.lower().endswith(('.jpg', '.jpeg')):
        # JPEG格式优化参数
        plt.savefig(output_path, 
                   bbox_inches='tight',
                   pad_inches=0,
                   dpi=600,
                   quality=100,  # 最高质量
                   optimize=True,
                   facecolor='white',  # JPEG必须指定背景色
                   pil_kwargs={'subsampling': 0, 'qtables': 'highest_quality'})
    else:
        raise ValueError("不支持的图片格式，建议使用PNG/TIFF")
    
    plt.close()
    print(f"图像已保存至：{output_path}")

# 使用示例（自动识别格式）
save_high_quality_mask('', 'output.png')  



import cv2
import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from PIL import Image

class BioImageAnalyzer:
    def __init__(self, image_folder):
        self.image_folder = image_folder
        self.um_per_px = 0.1  
        
    def _process_image(self, img_path, output_path=None):
        """优化后的图像处理流程"""
        try:
            img = cv2.imread(img_path)
            if img is None:
                raise ValueError("图像读取失败")
            
            # 二值化处理
            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            blurred = cv2.GaussianBlur(gray, (5,5), 0)
            _, binary = cv2.threshold(blurred, 0, 255, 
                                    cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
            
            # 优化保存方式
            if output_path:
                self._save_image(binary, output_path)
                
            return binary
        except Exception as e:
            raise RuntimeError(f"图像处理失败: {str(e)}")

    def _save_image(self, img, output_path):
        """兼容性图像保存方法"""
        if output_path.lower().endswith(('.png', '.tiff', '.tif')):
            plt.imsave(output_path, img, cmap='gray', format=output_path.split('.')[-1])
        elif output_path.lower().endswith(('.jpg', '.jpeg')):
            Image.fromarray(img).save(
                output_path, 
                quality=95, 
                subsampling=0, 
                optimize=True
            )
        else:
            raise ValueError("不支持的图片格式")

    def _measure_lengths(self, binary_img):
        """改进的长度测量方法"""
        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5,5))
        cleaned = cv2.morphologyEx(binary_img, cv2.MORPH_OPEN, kernel, iterations=2)
        
        contours, _ = cv2.findContours(cleaned, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        
        lengths = []
        for cnt in contours:
            if cv2.contourArea(cnt) < 20:
                continue
                
            rect = cv2.minAreaRect(cnt)
            length_px = max(rect[1])
            lengths.append(round(length_px * self.um_per_px, 2))
            
        return lengths

    def batch_process(self, output_excel="result.xlsx"):
        """增强的批量处理流程"""
        results = []
        images = [f for f in os.listdir(self.image_folder) 
                 if f.lower().endswith(('.jpg','.jpeg','.png'))]
        
        for img_name in images:
            if img_name == 'bar.jpeg':
                continue
                
            try:
                output_path = os.path.join(self.image_folder, f"binary_{img_name}")
                binary = self._process_image(
                    os.path.join(self.image_folder, img_name),
                    output_path
                )
                
                lengths = self._measure_lengths(binary)
                
                results.append({
                    'image_name': img_name,  
                    'bacteria_count': len(lengths),
                    'lengths_um': lengths,
                    'avg_length': np.mean(lengths) if lengths else 0
                })
                
            except Exception as e:
                print(f"处理失败: {img_name} - {str(e)}")
                continue
                
        if results:
            df = pd.DataFrame(results)

            expanded_data = []
            for row in results:
                for length in row['lengths_um']:
                    expanded_data.append({
                        'image_name': row['image_name'],
                        'length_um': length
                    })
                    
            pivot_df = pd.DataFrame(expanded_data).pivot_table(
                index=pd.Series(range(len(expanded_data)), name='index'),
                columns='image_name',
                values='length_um'
            )
            
            with pd.ExcelWriter(output_excel) as writer:
                df.to_excel(writer, sheet_name='汇总统计', index=False)
                pivot_df.to_excel(writer, sheet_name='详细数据')
            
            print(f"成功生成报告: {output_excel}")
        else:
            print("没有可处理的有效图像")

analyzer = BioImageAnalyzer(r'')
analyzer.batch_process(output_excel="明细.xlsx")



import cv2
