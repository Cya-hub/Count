# 交互式阈值调节
def interactive_threshold(img, img_name):
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    gray = clahe.apply(gray)

    _, init_mask = cv2.threshold(gray, 0, 255,
                                 cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
    init_thresh = int(_)

    win_name = f"Adjust Threshold - {img_name}"
    cv2.namedWindow(win_name, cv2.WINDOW_NORMAL)
    cv2.resizeWindow(win_name, 800, 800)
    cv2.createTrackbar("Threshold", win_name, init_thresh, 255, lambda x: None)

    print(f"\n正在调整阈值：{img_name}")
    print("拖动滑块实时查看效果，按任意键确认阈值并继续...")

    while True:
        thresh_val = cv2.getTrackbarPos("Threshold", win_name)
        _, mask = cv2.threshold(gray, thresh_val, 255, cv2.THRESH_BINARY_INV)

        cv2.imshow(win_name, mask)
        if cv2.waitKey(30) != -1:
            break

    cv2.destroyWindow(win_name)
    return thresh_val, mask


