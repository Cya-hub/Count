# 逐图二值化 + 轮廓检测
results = []
binary_output_dir = os.path.join(image_folder, "binary_output")
os.makedirs(binary_output_dir, exist_ok=True)

for img_name in images:
    if img_name == 'bar.jpeg':
        continue

    img_path = os.path.join(image_folder, img_name)
    img = cv2.imread(img_path)

    thresh_val, clean = interactive_threshold(img, img_name)

    out_path = os.path.join(binary_output_dir,
                            img_name.rsplit('.', 1)[0] + "_binary.png")
    cv2.imwrite(out_path, clean)

    contours, _ = cv2.findContours(clean, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    lengths = []
    for cnt in contours:
        rect = cv2.minAreaRect(cnt)
        w_rect, h_rect = rect[1]
        long_edge = max(w_rect, h_rect)
        length_um = long_edge * um_per_px
        lengths.append(length_um)

    results.append({
        '图片名称': img_name,
        '长度列表': lengths
    })

    print(f"完成：{img_name} → {len(lengths)} 个细菌")


